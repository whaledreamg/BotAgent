/* =====================================================
 * mainwindow.qss - BotAgent 监控台 (果冻风, 紧凑布局)
 *
 * 全部用 #objectName 选择器, 只影响主窗口里的具名控件,
 * 不会污染 theme_light.qss 定义的通用控件样式。
 *
 * 配色沿用 RobotControl 的果冻风:
 *   常态: 半透明底色 + 深色文字, 无描边, 圆角 10px
 *   hover: 底色变实色, 文字变白
 * ===================================================== */

QMainWindow#MainWindow {
    background-color: #F2F4F8;
}

QWidget#centralWidget {
    background-color: #F2F4F8;
}

/* ---------- 顶部工具条 ---------- */
QFrame#topBar {
    background-color: rgba(255, 255, 255, 230);
    border: 1px solid rgba(200, 210, 230, 180);
    border-radius: 12px;
}

QLabel#lblTitle {
    color: #1E1E1E;
    font-weight: bold;
    font-size: 12pt;
    background: transparent;
}

QLabel#lblOverview {
    color: #5A6478;
    background: transparent;
    font-size: 10pt;
    font-weight: bold;
}

QLabel#lblIntervalTitle {
    color: #5A6478;
    background: transparent;
    font-size: 9pt;
}

QLabel#lblHostTitle {
    color: #5A6478;
    background: transparent;
    font-size: 9pt;
}

/* 监控 IP 输入框 —— 果冻风半透明圆角 */
QLineEdit#editHost {
    background-color: rgba(255, 255, 255, 200);
    border: 1px solid rgba(200, 210, 230, 180);
    border-radius: 8px;
    padding: 4px 10px;
    color: #1E1E1E;
    font-size: 10pt;
    selection-background-color: #4a90e2;
    selection-color: #FFFFFF;
}
QLineEdit#editHost:focus {
    border: 1px solid #4a90e2;
    background-color: rgba(255, 255, 255, 240);
}
QLineEdit#editHost:disabled {
    background-color: rgba(230, 235, 245, 160);
    color: #A8B0C0;
}

QLabel#lblVersion {
    color: #8A93A6;
    background: transparent;
    font-size: 9pt;
}

/* 间隔线 */
QFrame#sep1, QFrame#sep2, QFrame#sep3 {
    color: #C8D0E0;
    background: #C8D0E0;
    max-width: 1px;
}

/* =====================================================
 * 底部服务状态条
 * ===================================================== */

QFrame#bottomBar {
    background-color: rgba(255, 255, 255, 230);
    border: 1px solid rgba(200, 210, 230, 180);
    border-radius: 12px;
}

QLabel#lblSvcTitle {
    color: #5A6478;
    background: transparent;
    font-size: 9pt;
    font-weight: bold;
}

/* 单个服务胶囊 */
QFrame#svcChip {
    background-color: rgba(244, 247, 252, 220);
    border: 1px solid rgba(200, 210, 230, 160);
    border-radius: 10px;
}

QFrame#svcChip:hover {
    background-color: rgba(230, 240, 255, 235);
    border: 1px solid rgba(74, 144, 226, 150);
}

QLabel#svcDot {
    background: transparent;
    font-size: 10pt;
}

QLabel#svcName {
    color: #1E1E1E;
    background: transparent;
    font-size: 9pt;
    font-weight: bold;
}

QLabel#svcState {
    background: transparent;
    font-size: 9pt;
}

QLabel#lblWsStatus,
QLabel#lblPollCount {
    color: #5A6478;
    background: transparent;
    font-size: 9pt;
}

/* =====================================================
 * 按钮 (果冻风)
 * ===================================================== */

/* 海蓝 primary: 开始/暂停监控 */
QPushButton#btnToggle {
    background-color: rgba(74, 144, 226, 90);
    color: #357abd;
    border: none;
    border-radius: 10px;
    padding: 6px 18px;
    font-weight: bold;
    font-size: 11pt;
}
QPushButton#btnToggle:hover {
    background-color: #4a90e2;
    color: #FFFFFF;
}
QPushButton#btnToggle:pressed {
    background-color: #357abd;
    color: #FFFFFF;
    padding-top: 7px;
    padding-bottom: 5px;
}

/* 中性按钮: 清空 */
QPushButton#btnClearEvents,
QPushButton#btnClearThinking {
    background-color: rgba(140, 150, 170, 70);
    color: #5A6478;
    border: none;
    border-radius: 10px;
    padding: 6px 16px;
    font-size: 10pt;
}
QPushButton#btnClearEvents:hover,
QPushButton#btnClearThinking:hover {
    background-color: #8a93a6;
    color: #FFFFFF;
}
QPushButton#btnClearEvents:pressed,
QPushButton#btnClearThinking:pressed {
    background-color: #6f7889;
    color: #FFFFFF;
    padding-top: 7px;
    padding-bottom: 5px;
}

/* =====================================================
 * 对话流程面板 (中)
 * ===================================================== */

QScrollArea#flowPanel {
    background-color: transparent;
    border: 1px solid rgba(200, 210, 230, 180);
    border-radius: 10px;
}

QWidget#flowContainer {
    background-color: transparent;
}

/* 顶部流水线状态条 */
QFrame#flowStateBar {
    background-color: rgba(74, 144, 226, 30);
    border: 1px solid rgba(74, 144, 226, 90);
    border-radius: 8px;
}

QLabel#flowStateValue {
    color: #357abd;
    background: transparent;
    font-weight: bold;
    font-size: 11pt;
}

QLabel#flowStateHint {
    color: #7A8496;
    background: transparent;
    font-size: 9pt;
}

/* ---------- 流程卡片 ---------- */
QFrame#flowCard {
    background-color: rgba(255, 255, 255, 245);
    border: 1px solid rgba(200, 210, 230, 200);
    border-radius: 10px;
}

QLabel#flowTime {
    color: #357abd;
    background: transparent;
    font-weight: bold;
    font-size: 10pt;
}

QLabel#flowBadge {
    color: #FFFFFF;
    background-color: #4a90e2;
    border-radius: 7px;
    padding: 1px 9px;
    font-size: 9pt;
    font-weight: bold;
}

/* 「手动」徽标 —— 手动输入的轮次 */
QLabel#flowManualBadge {
    color: #8A5A00;
    background-color: rgba(255, 193, 7, 90);
    border-radius: 7px;
    padding: 1px 9px;
    font-size: 9pt;
    font-weight: bold;
}

QLabel#flowPhase {
    color: #8A93A6;
    background: transparent;
    font-size: 9pt;
}

/* 小标题 (ASR 识别 / Agent 分流 ...) */
QLabel#flowCaption {
    color: #8A93A6;
    background: transparent;
    font-size: 9pt;
    font-weight: bold;
    min-width: 62px;
    max-width: 62px;
}

/* 内容区 —— 自动换行, 完整显示 */
QLabel#flowValue {
    color: #1E1E1E;
    background: transparent;
    font-size: 10pt;
}

/* 系统事件 (Arm / Vision) */
QLabel#flowSystemEvent {
    color: #6B7488;
    background: transparent;
    font-size: 9pt;
}

/* =====================================================
 * 识别状态列 (中间那一栏)
 * ===================================================== */

/* 三态动画控件 —— 自身不画背景, 动画是 QPainter 现画的 */
AsrStatusIndicator {
    background-color: transparent;
    border: none;
}

/* 标注图预览 */
QLabel#visionImagePreview,
QLabel#lblVisionImage {
    color: #8A93A6;
    background-color: rgba(74, 144, 226, 14);
    border: 1px solid rgba(74, 144, 226, 45);
    border-radius: 8px;
    font-size: 8pt;
}

/* 「识别一次」按钮 —— 主操作, 颜色比别的按钮重一点 */
QPushButton#btnDetect {
    background-color: rgba(74, 144, 226, 210);
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 9pt;
    font-weight: bold;
}

QPushButton#btnDetect:hover {
    background-color: rgba(74, 144, 226, 240);
}

QPushButton#btnDetect:pressed {
    background-color: rgba(74, 144, 226, 180);
}

QPushButton#btnDetect:disabled {
    background-color: rgba(150, 160, 180, 120);
    color: rgba(255, 255, 255, 160);
}

/* 图像识别结果列表 */
QListWidget#listVision {
    color: #1E1E1E;
    background-color: rgba(255, 255, 255, 245);
    border: 1px solid rgba(200, 210, 230, 200);
    border-radius: 8px;
    font-size: 9pt;
}

QListWidget#listVision::item {
    padding: 3px 4px;
    border-bottom: 1px solid rgba(200, 210, 230, 90);
}

QListWidget#listVision::item:selected {
    background-color: rgba(74, 144, 226, 40);
    color: #1E1E1E;
}

/* =====================================================
 * 手动指令输入区 (底部状态栏上方)
 *
 * 参考 Cursor 的输入框:
 *   - 中间是**胶囊体**输入区 —— 左右边缘都是大圆角, 像个药丸
 *   - 左侧 `+` 按钮, 右侧圆形发送箭头 `↑`
 *   - 输入区有极淡的投影, 浮在面板之上
 * ===================================================== */

/* 外层只负责排版, 自己不画任何东西 */
QFrame#commandBar {
    background-color: transparent;
    border: none;
}

/* 左侧 + 按钮 —— 无边框, 悬停才显形 */
QPushButton#btnAttach {
    background-color: transparent;
    border: none;
    border-radius: 13px;
    color: #6B7280;
    font-size: 16pt;
    font-weight: bold;
    padding: 0;
    outline: 0;
}
QPushButton#btnAttach:hover {
    background-color: #F0F2F6;
    color: #1E1E1E;
}
QPushButton#btnAttach:pressed {
    background-color: #E4E7EE;
}

/* 输入区 —— 胶囊体: 左右边缘都是大圆角 */
QPlainTextEdit#editCommand {
    background-color: #FFFFFF;
    border: 1px solid #E3E6ED;
    border-radius: 20px;
    color: #1E1E1E;
    font-size: 10pt;
    padding: 8px 18px;
    min-height: 20px;
    selection-background-color: #4a90e2;
    selection-color: #FFFFFF;
}
QPlainTextEdit#editCommand:hover {
    border-color: #D4D8E2;
}
QPlainTextEdit#editCommand:focus {
    border: 1px solid #C7CDD9;
    background-color: #FFFFFF;
}
QPlainTextEdit#editCommand:disabled {
    background-color: #F7F8FA;
    color: #A8B0C0;
    border-color: #E8EAEF;
}

/* 输入框里的滚动条 —— 细一点, 别抢镜 */
QPlainTextEdit#editCommand QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px;
}
QPlainTextEdit#editCommand QScrollBar::handle:vertical {
    background-color: #D0D4DC;
    border-radius: 4px;
    min-height: 20px;
}
QPlainTextEdit#editCommand QScrollBar::handle:vertical:hover {
    background-color: #B4BAC6;
}
QPlainTextEdit#editCommand QScrollBar::add-line,
QPlainTextEdit#editCommand QScrollBar::sub-line,
QPlainTextEdit#editCommand QScrollBar::add-page,
QPlainTextEdit#editCommand QScrollBar::sub-page {
    background: none;
    height: 0;
    width: 0;
}

/* 发送按钮 —— 圆形深色箭头, 有内容才点亮 */
QPushButton#btnSend {
    background-color: #E8EAEF;
    border: none;
    border-radius: 14px;
    color: #9AA1AE;
    font-size: 13pt;
    font-weight: bold;
    padding: 0;
    outline: 0;
}
QPushButton#btnSend:hover {
    background-color: #1E1E1E;
    color: #FFFFFF;
}
QPushButton#btnSend:pressed {
    background-color: #333333;
    color: #FFFFFF;
}
QPushButton#btnSend:disabled {
    background-color: #F0F2F5;
    color: #C4C9D2;
}

/* =====================================================
 * 三面板分组框
 * ===================================================== */

QGroupBox#statusGroup,
QGroupBox#eventGroup,
QGroupBox#thinkingGroup {
    background-color: rgba(255, 255, 255, 235);
    border: 1px solid rgba(200, 210, 230, 180);
    border-radius: 12px;
    margin-top: 14px;
    padding: 8px;
}

QGroupBox#statusGroup::title,
QGroupBox#eventGroup::title,
QGroupBox#thinkingGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 2px 8px;
    color: #357abd;
    font-size: 10pt;
    font-weight: bold;
    background-color: #FFFFFF;
    border: 1px solid rgba(200, 210, 230, 180);
    border-radius: 6px;
}
